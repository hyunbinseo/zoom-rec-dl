{
	"name": "zoom-rec-dl",
	"version": "3.0.0-beta.0",
	"description": "Download Zoom cloud recordings from share links. API and CLI.",
	"keywords": [
		"cli",
		"download",
		"recording",
		"zoom"
	],
	"homepage": "https://github.com/hyunbinseo/zoom-rec-dl#readme",
	"bugs": {
		"url": "https://github.com/hyunbinseo/zoom-rec-dl/issues"
	},
	"license": "MIT",
	"author": "Hyunbin Seo",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyunbinseo/zoom-rec-dl.git"
	},
	"bin": {
		"zoom-rec-dl": "./dist/cli.mjs"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"check": "vp check",
		"dev": "vp pack --watch",
		"format": "vp fmt",
		"prepare": "vp config",
		"prepublishOnly": "vp run build",
		"test": "vp test"
	},
	"dependencies": {
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"typescript": "^7.0.2",
		"vite-plus": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.21.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "26.13.1",
			"onFail": "download"
		}
	},
	"engines": {
		"node": ">=26.13.0"
	}
}
