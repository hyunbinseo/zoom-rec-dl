{
	"name": "zoom-rec-dl",
	"description": "Save Zoom cloud recordings to a local directory.",
	"version": "2.1.10",
	"license": "MIT",
	"dependencies": {
		"new-request": "^0.0.33",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^18.19.130",
		"eslint": "^9.39.5",
		"prettier": "^3.10.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.73.0"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"prepack": "tsc",
		"postversion": "git push && git push --tags && node cli/postversion.ts"
